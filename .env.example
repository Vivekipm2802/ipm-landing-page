# ===========================================
# IPM Landing Page - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env.local to version control.
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# IMPORTANT: NO "NEXT_PUBLIC_" prefix — this key must stay server-side only.
# It bypasses Row Level Security; exposing it in the browser is a critical vulnerability.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Primary Mail Server (mail.ipmcareer.com) ---
MAIL_SERVER_PRIMARY=mail.ipmcareer.com
MAIL_USER_PRIMARY=register@ipmcareer.com
MAIL_PASS_PRIMARY=your-primary-mail-password

# --- Zoho Mail Server ---
MAIL_SERVER_ZOHO=smtppro.zoho.in
MAIL_USER_ZOHO=info@ipmcareer.in
MAIL_PASS_ZOHO=your-zoho-mail-password

# --- ZeptoMail (transactional email) ---
ZEPTOMAIL_SERVER=smtp.zeptomail.in
ZEPTOMAIL_API_KEY=your-zeptomail-api-key
MAIL_FROM_NOREPLY=noreply@ipmcareer.com

# --- Admin Auth ---
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# --- Salesforce (server-side only — NO NEXT_PUBLIC_ prefix!) ---
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_USERNAME=your-salesforce-username
SALESFORCE_PASSWORD=your-salesforce-password

# --- TCY Online ---
TCY_CLIENT_ID=3158
TCY_SECURITY_CODE=your-tcy-security-code
TCY_COURSE_ID=35736
TCY_CATEGORY_ID=835941

# --- Interakt (WhatsApp automation) ---
INTERAKT_API_KEY=your-interakt-base64-api-key

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key

# --- Cronberry (used in client-side pages — needs NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_CRONBERRY_PROJECT_KEY=your-cronberry-project-key

# --- Cronberry (used in API routes — server-side) ---
CRONBERRY_PROJECT_KEY=your-cronberry-project-key
